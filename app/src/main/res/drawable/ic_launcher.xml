<?xml version="1.0" encoding="utf-8"?>
<!-- App 圖示：藍紫漸層圓底 + 白色螢幕 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#7D5CFF"
                android:startColor="#5AC8FA" />
            <size android:width="96dp" android:height="96dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_desktop" android:bottom="24dp" android:left="24dp" android:right="24dp" android:top="24dp" />
</layer-list>
